{
  "name": "@beamhop/sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A computer in a browser tab: kernel, Node layer and machine frame for running coding-agent harnesses.",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./protocol": "./src/protocol.ts",
    "./harness": "./src/harness/index.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:image": "node scripts/build-image.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run --root ../.. packages/sandbox",
    "e2e": "node test/e2e/run.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "acorn": "8.19.0",
    "assert": "2.1.0",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "fflate": "0.8.3",
    "just-bash": "3.6.1",
    "magic-string": "^0.30.17",
    "path-browserify": "1.0.1",
    "punycode": "2.3.1",
    "querystring-es3": "0.2.1",
    "readable-stream": "4.8.0",
    "string_decoder": "1.3.0",
    "url": "0.11.4",
    "util": "0.12.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8",
    "esbuild": "0.28.2",
    "ws": "8.23.0"
  }
}
