{
  "name": "@beamhop/tls",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tunnel": "./src/tunnel.ts",
    "./wasm": "./src/generated/beamhop_tls_wasm_bg.wasm"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:roots": "node scripts/build-roots.mjs",
    "sizes": "node scripts/sizes.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run --root . --dir test",
    "e2e": "node e2e/run.mjs",
    "e2e:public": "BH_TLS_PUBLIC=1 node e2e/run.mjs"
  },
  "devDependencies": {
    "@peculiar/x509": "^3.1.0",
    "@types/node": "^22",
    "@types/ws": "^8",
    "esbuild": "0.28.2",
    "reflect-metadata": "^0.2.2",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "ws": "8.23.0"
  }
}
