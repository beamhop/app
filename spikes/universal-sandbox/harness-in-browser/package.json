{
  "name": "harness-in-browser-spike",
  "private": true,
  "version": "0.0.0",
  "description": "Feasibility spike: unmodified coding-agent CLIs on the browser's JS engine in one worker, behind a Node.js emulation layer",
  "type": "module",
  "scripts": {
    "install:harnesses": "node scripts/install-harnesses.mjs",
    "build": "node scripts/build.mjs",
    "spike": "node scripts/install-harnesses.mjs && node scripts/build.mjs && node scripts/scan-sync.mjs && node scripts/run.mjs",
    "spike:run": "node scripts/run.mjs",
    "native": "node scripts/native-baseline.mjs"
  },
  "dependencies": {
    "@babel/core": "^8.1.3",
    "@babel/plugin-transform-dynamic-import": "^8.0.1",
    "@babel/plugin-transform-modules-systemjs": "^8.1.3",
    "@noble/hashes": "^2.4.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "events": "^3.3.0",
    "fflate": "^0.8.3",
    "just-bash": "^3.6.1",
    "path-browserify": "^1.0.1",
    "punycode": "^2.3.1",
    "querystring-es3": "^0.2.1",
    "readable-stream": "^4.8.0",
    "ses": "^2.3.0",
    "string_decoder": "^1.3.0",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "ws": "^8.23.0"
  }
}
